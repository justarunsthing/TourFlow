@implements IDisposable

@inject NavigationManager NavigationManager

<MudNavMenu>
    <AuthorizeView Roles="@($"{Role.Admin}")">
        <MudNavGroup Title="Home" Expanded="true">
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Role.TravelAgent}")">
        <MudNavGroup Title="Enquiries" Expanded>
            <MudNavLink Href="/enquiries" Icon="@Icons.Material.Filled.FolderShared">
                My Enquiries
            </MudNavLink>
            <MudNavLink Href="/bookings" Icon="@Icons.Material.Filled.FolderShared">
                My Bookings
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Role.Admin}, {Role.Manager}, {Role.Sales}")">
        <MudNavGroup Title="Enquiries" Expanded>
            <MudNavLink Href="/enquiries" Icon="@Icons.Material.Filled.FolderShared">
                All Enquiries
            </MudNavLink>
            <MudNavLink Href="/bookings" Icon="@Icons.Material.Filled.FolderShared">
                All Bookings
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <MudNavGroup Title="Account" Expanded>
        <AuthorizeView>
            <Authorized>
                <MudNavLink Href="/account/manage" Icon="@Icons.Material.Filled.Person">
                    @context.User.Identity!.Name
                </MudNavLink>
                <MudNavLink UserAttributes="@(new() { ["onclick"] = "logoutForm.submit()" })"
                            ActiveClass=""
                            Icon="@Icons.Material.Filled.Logout">
                    Logout
                </MudNavLink>

                <form id="logoutForm" class="d-none" action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                </form>
            </Authorized>
            <NotAuthorized>
                <MudNavLink Href="/account/login" Icon="@Icons.Material.Filled.Login">
                    Login
                </MudNavLink>
                <MudNavLink Href="/account/register" Icon="@Icons.Material.Filled.PersonAdd">
                    Register
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavGroup>
</MudNavMenu>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}