@page "/enquiries"
@using TourFlow.Client.UI.Enquiries
@attribute [Authorize]
@inject IEnquiryDTOService EnquiryService

<PageTitle>All Enquiries | Tour Flow</PageTitle>


<MudContainer MaxWidth="MaxWidth.Large" Class="py-4 page-container">

    @if (enquiries.Count() > 0)
    {
        <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
            @foreach (var enquiry in enquiries)
            {
@*                 <div class="col">
                    <EnquiryCard Enquiry="enquiry"/>
                </div> *@
            }
        </div>
    }
    else
    {
        <div class="h-100 d-flex align-items-center justify-content-center">
            <MudText Color="Color.Tertiary" Typo="Typo.button">
                No Enquiries Found
            </MudText>
        </div>
    }
</MudContainer>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private IEnumerable<EnquiryDTO> enquiries = [];

    protected override async Task OnInitializedAsync()
    {
        UserInfo? userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);
        enquiries = await EnquiryService.GetAllEnquiriesAsync();
    }
}